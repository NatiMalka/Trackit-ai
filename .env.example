# Copy to .env.local and fill in from the Firebase console
# (Project settings > General > Your apps > Web app > SDK setup and configuration).
# Every VITE_ value is embedded in the client bundle. That is expected for
# Firebase web config, which is why App Check and Firestore rules do the real
# security work.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check. Console > Security > App Check > register the web app with
# reCAPTCHA Enterprise. Required for Firebase AI Logic from 2026-11-02.
VITE_RECAPTCHA_SITE_KEY=

# Local dev only. Set to `true`, load the app once, then copy the debug token
# the console logs into Console > App Check > Manage debug tokens.
VITE_APPCHECK_DEBUG_TOKEN=

# 'mock' = demo journeys. 'ship24' = call Ship24 from the browser (needs
# VITE_SHIP24_API_KEY). 'api' = Cloud Function (Blaze, key stays server-side).
# If VITE_SHIP24_API_KEY is set, ship24 is used even when this is still mock.
VITE_TRACKING_PROVIDER=mock

# Personal use only — this value is embedded in the client JS. Dashboard →
# Integrations → API keys. Subscribe to the free *per-shipment* plan, not per-call.
VITE_SHIP24_API_KEY=

VITE_GEMINI_MODEL=gemini-3.6-flash

# Phase 3 push. Console > Project settings > Cloud Messaging > Web Push certificates.
VITE_FIREBASE_VAPID_KEY=
